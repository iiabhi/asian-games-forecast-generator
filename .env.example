# Copy to .env.local. Never commit .env.local.

# Gemini API key (free tier works) — used only by `npm run refresh:forecast`, server-side.
LLM_API_KEY=
# Optional: Gemini model id (default gemini-2.5-flash-lite)
LLM_MODEL=

# Wikipedia asks API clients to send a descriptive User-Agent with a contact, e.g.
# ChakDeIndiaTracker/1.0 (you@example.com)
WIKI_USER_AGENT=

# Secret for /api/refresh (external cron) (send as "Authorization: Bearer <token>"). Leave empty to disable the route.
REFRESH_TOKEN=

# Auto refresh interval in minutes while the server runs (default 20, 0 = off).
AUTO_REFRESH_MINUTES=

# --- Vercel ---
# Created automatically when you add a Blob store to the project (Storage tab). For local runs that should
# write to the same store (e.g. `npm run refresh:forecast`), run `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" (set it in the Vercel project env vars).
CRON_SECRET=
